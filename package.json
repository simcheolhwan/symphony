{
  "name": "symphony",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check {launcher,notifier}/src vite.config.ts",
    "check:fix": "vp check --fix {launcher,notifier}/src vite.config.ts",
    "fmt": "vp fmt {launcher,notifier}/src vite.config.ts",
    "install:bin": "launcher/install.sh",
    "lint": "vp lint {launcher,notifier}/src vite.config.ts",
    "lint:fix": "vp lint --fix {launcher,notifier}/src vite.config.ts",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@simcheolhwan/oxlint-config": "github:simcheolhwan/oxlint-config",
    "@tsconfig/bases": "latest",
    "@types/node": "latest",
    "mise": "latest",
    "vite-plus": "latest"
  }
}
